# COLLEGE GEAR — server environment (never commit real values)
PORT=3000
NODE_ENV=development
# Optional extra allowed origins for cross-origin API mutations (comma-separated)
CLIENT_URL=

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# No login/authentication: each browser gets an anonymous workspace cookie (stored hashed in the DB).
# Set to false to disable the open Admin panel on a public deployment.
ADMIN_PANEL_ENABLED=true

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

UPLOAD_MAX_SIZE_MB=10

# Optional: isolated Judge0 sandbox for Java/C/C++ execution
JUDGE0_URL=
JUDGE0_API_KEY=

# Client: no variables required. The browser calls relative /api paths and never receives secrets.
